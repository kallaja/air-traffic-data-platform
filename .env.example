# OpenSky
OPEN_SKY_CLIENT_ID=
OPEN_SKY_CLIENT_SECRET=

# REST Countries v5 (required — legacy /v3.1 is deprecated)
# Sign up: https://restcountries.com/sign-up
REST_COUNTRIES_URL=https://api.restcountries.com/countries/v5
REST_COUNTRIES_API_KEY=

# Azure Storage — use connection string locally OR account name + DefaultAzureCredential
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_CONTAINER_NAME=bronze
AZURE_METADATA_CONTAINER_NAME=metadata
