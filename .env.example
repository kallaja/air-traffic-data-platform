# OpenSky API
OPEN_SKY_CLIENT_ID=
OPEN_SKY_CLIENT_SECRET=

# REST Countries API v5
# Sign up: https://restcountries.com/sign-up
REST_COUNTRIES_URL=https://api.restcountries.com/countries/v5
REST_COUNTRIES_API_KEY=

# Ingestion storage configuration
# Used by Python ingestion and Azure Functions.

# For Azure, use a connection string locally OR an account name with DefaultAzureCredential.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_NAME=

AZURE_CONTAINER_NAME=bronze
AZURE_METADATA_CONTAINER_NAME=metadata

# Optional local storage backend for development and samples.
# Set STORAGE_BACKEND=local to write files to LOCAL_STORAGE_ROOT.
# Set STORAGE_BACKEND=azure to use Azure Storage.

STORAGE_BACKEND=azure
LOCAL_STORAGE_ROOT=sample_data

# ============================================================
# Databricks transformation: Bronze -> Silver
# ============================================================

# These paths are read by the OpenSky Silver transformation.
# They must point to the roots of the Bronze and metadata storage.

# Azure Databricks + ADLS Gen2:
# BRONZE_BASE_PATH=abfss://bronze@<storage-account>.dfs.core.windows.net/
# METADATA_BASE_PATH=abfss://metadata@<storage-account>.dfs.core.windows.net/
# SILVER_OPENSKY_CHECKPOINT_PATH=abfss://metadata@<storage-account>.dfs.core.windows.net/checkpoints/opensky_states
#
# Databricks Free Edition + Unity Catalog Managed Volume:
# BRONZE_BASE_PATH=/Volumes/workspace/default/air_traffic_data/bronze/
# METADATA_BASE_PATH=/Volumes/workspace/default/air_traffic_data/metadata/
# SILVER_OPENSKY_CHECKPOINT_PATH=/Volumes/workspace/default/air_traffic_data/checkpoints/opensky_states
# SILVER_OPENSKY_TABLE=workspace.silver.opensky_states
#
# Catalog/schema must already exist. Auth and storage access are set up outside this file.
# Databricks will not load .env.example by itself — set the same vars on the cluster/job.
# Checkpoint path should be durable and outside bronze (Auto Loader stores progress there).

BRONZE_BASE_PATH=
METADATA_BASE_PATH=
SILVER_OPENSKY_TABLE=
SILVER_OPENSKY_CHECKPOINT_PATH=
